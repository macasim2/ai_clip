# ============================================================================
# AI Clip Studio configuration
# Copy this file to .env and fill only what you need. Never commit .env.
# ============================================================================

# --- Twitch -----------------------------------------------------------------
# graphql: temporary public web Client-ID, no own app / 2FA required (default)
# helix:   official API, requires TWITCH_CLIENT_ID + TWITCH_CLIENT_SECRET
TWITCH_PROVIDER=graphql
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Public Twitch website Client-ID used only by the graphql provider.
# This is NOT an application credential owned by this project.
TWITCH_WEB_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko
TWITCH_TIMEOUT=20
TWITCH_MAX_PAGES=20

# --- Ollama (local AI) ------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=llava:latest
# Optional fast model for a first-pass screen; leave empty to disable.
OLLAMA_FAST_MODEL=
OLLAMA_TIMEOUT=240
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=4096

# --- Whisper ----------------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_BEAM_SIZE=5

# --- Analysis ---------------------------------------------------------------
FRAME_INTERVAL_SEC=1.5
MIN_FRAMES=4
MAX_FRAMES=20
SCENE_THRESHOLD=0.3
ANALYZE_VISION=true
VISION_BATCH_SIZE=1

# --- Gating / moment selection ---------------------------------------------
MIN_SCORE_CANDIDATE=60
MIN_SCORE_REVIEW=40
MIN_CLIP_DURATION=8
MAX_CLIP_DURATION=45

# --- Editing ----------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_BITRATE=6M
VIDEO_CRF=20
VIDEO_PRESET=medium
# blur = game video centered on a blurred copy of itself (default, no HUD loss)
# crop = full-screen vertical center crop
EDIT_MODE=blur

# --- Subtitles --------------------------------------------------------------
SUBTITLES_ENABLED=true
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=64
SUBTITLE_STYLE=normal
SUBTITLE_MAX_WORDS=4
SUBTITLE_MAX_CHARS=24
SUBTITLE_MAX_DURATION=4
SUBTITLE_MARGIN_V=140

# --- Queue / resilience -----------------------------------------------------
MAX_PARALLEL=1
RETRY_ATTEMPTS=3
MAX_ATTEMPTS=3
STALE_LOCK_MINUTES=30
MIN_FREE_DISK_MB=1024
CLEANUP_DAYS=14
DB_BACKUP=true

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
