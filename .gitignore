# secrets
.env

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# runtime data (keep the directory placeholders for a fresh clone)
logs/*
!logs/.gitkeep
exports/*
!exports/.gitkeep
!exports/**/
!exports/**/.gitkeep
processed/*
!processed/.gitkeep
raw_clips/*.mp4
raw_clips/*.part*
raw_clips/.tmp/
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/*
!data/backups/.gitkeep

# media / binaries
ffmpeg.exe
*.mp4
*.wav

# os
Thumbs.db
desktop.ini
